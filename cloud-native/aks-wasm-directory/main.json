{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "4681228222053259856"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the AKS cluster."
      }
    },
    "clusterName": {
      "type": "string",
      "defaultValue": "aks-wasm-directory",
      "metadata": {
        "description": "Name of the AKS cluster."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D2s_v5",
      "metadata": {
        "description": "VM size for the learning cluster nodes."
      }
    },
    "nodeCount": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 1,
      "maxValue": 5,
      "metadata": {
        "description": "Node count. Two nodes give the registry, PostgreSQL, Envoy Gateway, and cert-manager room to schedule."
      }
    },
    "domainName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Public application hostname. Leave empty to use an Azure-provided DNS label."
      }
    },
    "dnsLabel": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Azure-managed public IP DNS label. With no domainName, leave empty to derive a stable unique label."
      }
    },
    "selfSigned": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Use a self-signed certificate instead of the default Azure DNS-label and Let's Encrypt path. An explicit dnsLabel may still annotate the public IP."
      }
    },
    "acmeEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional email address for the Let's Encrypt ACME account."
      }
    }
  },
  "variables": {
    "useSelfSigned": "[and(equals(parameters('domainName'), ''), parameters('selfSigned'))]",
    "useAzureProvidedHostname": "[and(equals(parameters('domainName'), ''), not(variables('useSelfSigned')))]",
    "useDnsLabel": "[or(not(equals(parameters('dnsLabel'), '')), variables('useAzureProvidedHostname'))]",
    "suffix": "[substring(uniqueString(resourceGroup().id), 0, 6)]",
    "generatedDnsLabel": "[format('wasm-directory-{0}', uniqueString(resourceGroup().id, parameters('clusterName'), toLower(parameters('location'))))]",
    "effectiveDnsLabel": "[if(not(equals(parameters('dnsLabel'), '')), parameters('dnsLabel'), variables('generatedDnsLabel'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2026-01-01",
      "name": "[parameters('clusterName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "sku": {
        "name": "Base",
        "tier": "Free"
      },
      "properties": {
        "dnsPrefix": "[format('{0}-{1}', parameters('clusterName'), variables('suffix'))]",
        "enableRBAC": true,
        "agentPoolProfiles": [
          {
            "name": "systempool",
            "count": "[parameters('nodeCount')]",
            "vmSize": "[parameters('vmSize')]",
            "mode": "System",
            "osType": "Linux",
            "osSKU": "AzureLinux3"
          }
        ],
        "networkProfile": {
          "networkPlugin": "azure",
          "networkPluginMode": "overlay",
          "networkPolicy": "azure",
          "loadBalancerSku": "standard"
        }
      }
    }
  ],
  "outputs": {
    "clusterName": {
      "type": "string",
      "value": "[parameters('clusterName')]"
    },
    "domainName": {
      "type": "string",
      "value": "[if(not(equals(parameters('domainName'), '')), parameters('domainName'), if(variables('useAzureProvidedHostname'), format('{0}.{1}.cloudapp.azure.com', variables('effectiveDnsLabel'), toLower(parameters('location'))), 'wasm-directory.local'))]"
    },
    "dnsLabel": {
      "type": "string",
      "value": "[if(variables('useDnsLabel'), variables('effectiveDnsLabel'), '')]"
    },
    "clusterLocation": {
      "type": "string",
      "value": "[toLower(parameters('location'))]"
    },
    "acmeEmail": {
      "type": "string",
      "value": "[parameters('acmeEmail')]"
    },
    "certificateMode": {
      "type": "string",
      "value": "[if(variables('useAzureProvidedHostname'), 'letsencrypt-azure-http01', if(variables('useSelfSigned'), 'selfsigned', 'letsencrypt-http01'))]"
    }
  }
}
