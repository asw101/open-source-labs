# Keep the historical YYMM00 resource group format used by the Mage targets.
resource_group := env_var_or_default("RESOURCE_GROUP", `date +%y%m` + "00-mariner")
location := env_var_or_default("LOCATION", "eastus")
vm_name := env_var_or_default("VM_NAME", "vm1")
vm_size := env_var_or_default("VM_SIZE", "Standard_B2s")
vm_image := env_var_or_default("VM_IMAGE", "MicrosoftCBLMariner:cbl-mariner:cbl-mariner-2-gen2:latest")
# The CLI target used 32 GiB while the Bicep target used 128 GiB.
vm_cli_os_disk_size := env_var_or_default("VM_OS_DISK_SIZE", "32")
vm_os_disk_size := env_var_or_default("VM_OS_DISK_SIZE", "128")
vm_customdata := env_var_or_default("VM_CUSTOMDATA", "none")
vm_command := env_var_or_default("VM_COMMAND", "")
vm_script := env_var_or_default("VM_SCRIPT", "")
ssh_key_name := env_var_or_default("SSH_KEY_NAME", "sshkey1")
ssh_key := env_var_or_default("SSH_KEY", "")
environment := env_var_or_default("ENV", "{}")
ip_allow := env_var_or_default("IP_ALLOW", "")
ts_authkey := env_var_or_default("TS_AUTHKEY", "")
pg_name := env_var_or_default("PG_NAME", "")
pg_tier := env_var_or_default("PG_TIER", "Burstable")
pg_sku := env_var_or_default("PG_SKU", "Standard_B1ms")
pg_version := env_var_or_default("PG_VERSION", "15")
pg_storage_size := env_var_or_default("PG_STORAGE_SIZE", "128")
sub1 := env_var_or_default("SUB1", "")
sub2 := env_var_or_default("SUB2", "")

export RESOURCE_GROUP := resource_group
export LOCATION := location
export VM_NAME := vm_name
export VM_SIZE := vm_size
export VM_IMAGE := vm_image
export VM_OS_DISK_SIZE := vm_os_disk_size
export VM_CUSTOMDATA := vm_customdata
export VM_COMMAND := vm_command
export VM_SCRIPT := vm_script
export SSH_KEY_NAME := ssh_key_name
export SSH_KEY := ssh_key
export ENV := environment
export IP_ALLOW := ip_allow
export TS_AUTHKEY := ts_authkey
export PG_NAME := pg_name
export PG_TIER := pg_tier
export PG_SKU := pg_sku
export PG_VERSION := pg_version
export PG_STORAGE_SIZE := pg_storage_size
export SUB1 := sub1
export SUB2 := sub2
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT := "1"

default:
    @just --list

# Create the Azure resource group.
group-create:
    az group create --name "$RESOURCE_GROUP" --location "$LOCATION"

# Deleting a resource group destroys any role assignment scoped to it, so where
# your access is granted at the group scope rather than the subscription, reach
# for this instead of group-delete.

# Empty the resource group, leaving the group itself in place.
group-empty:
    #!/usr/bin/env bash
    set -euo pipefail
    temp_dir="$(mktemp -d)"
    empty_bicep="$temp_dir/empty.bicep"
    trap 'rm -f "$empty_bicep"; rmdir "$temp_dir"' EXIT
    : > "$empty_bicep"

    printf 'Emptying RESOURCE_GROUP %s in 10 seconds.\n' "$RESOURCE_GROUP"
    sleep 10
    az deployment group create \
        --resource-group "$RESOURCE_GROUP" \
        --template-file "$empty_bicep" \
        --mode Complete

# Delete the Azure resource group and everything in it.
group-delete:
    #!/usr/bin/env bash
    set -euo pipefail
    printf 'Deleting RESOURCE_GROUP %s in 10 seconds.\n' "$RESOURCE_GROUP"
    sleep 10
    az group delete --resource-group "$RESOURCE_GROUP" --yes

# Create the Azure VM directly with the Azure CLI.
vm:
    #!/usr/bin/env bash
    set -euo pipefail
    az vm create \
        --resource-group "$RESOURCE_GROUP" \
        --name "$VM_NAME" \
        --image "$VM_IMAGE" \
        --admin-username azureuser \
        --generate-ssh-keys \
        --public-ip-sku Standard \
        --size "$VM_SIZE" \
        --os-disk-size-gb "{{ vm_cli_os_disk_size }}"

# Deploy vm.bicep at resource group scope.
vm-bicep:
    #!/usr/bin/env bash
    set -euo pipefail

    custom_data="$VM_CUSTOMDATA"
    if [[ "$custom_data" != "cloud-init" ]]; then
        custom_data="none"
    fi

    ip_allow="$IP_ALLOW"
    if [[ -z "$ip_allow" ]]; then
        ip_allow="$(curl --fail --silent --show-error https://myip.dnsomatic.com/)"
    fi

    ssh_public_key=""
    if [[ -n "$SSH_KEY" ]]; then
        if [[ ! -f "$SSH_KEY" ]]; then
            printf 'SSH_KEY does not exist: %s\n' "$SSH_KEY" >&2
            exit 1
        fi
        ssh_public_key="$(<"$SSH_KEY")"
        if [[ "$ssh_public_key" == "-----BEGIN OPENSSH PRIVATE KEY-----"* ]]; then
            printf 'SSH_KEY is a private key. Provide a public key instead.\n' >&2
            exit 1
        fi
    else
        printf 'SSH_KEY not set. Using the template default.\n'
    fi

    az deployment group create \
        --resource-group "$RESOURCE_GROUP" \
        --template-file vm.bicep \
        --parameters \
            "location=$LOCATION" \
            "vmName=$VM_NAME" \
            "vmSize=$VM_SIZE" \
            "osDiskSize=$VM_OS_DISK_SIZE" \
            "sshKey=$ssh_public_key" \
            "allowIpPort22=$ip_allow" \
            "customData=$custom_data" \
            "env=$ENV"

# Create an Azure Database for PostgreSQL flexible server.
pg:
    #!/usr/bin/env bash
    set -euo pipefail

    pg_name="$PG_NAME"
    if [[ -z "$pg_name" ]]; then
        group_id="$(az group show --resource-group "$RESOURCE_GROUP" --query id --output tsv)"
        suffix="$(printf '%s' "$group_id" | sha256sum | cut -c1-6)"
        pg_name="postgres-$suffix"
    fi

    vnet_name="$(az network vnet list \
        --resource-group "$RESOURCE_GROUP" \
        --query '[0].name' \
        --output tsv)"
    if [[ -z "$vnet_name" ]]; then
        printf 'No virtual network found in RESOURCE_GROUP %s.\n' "$RESOURCE_GROUP" >&2
        exit 1
    fi

    az postgres flexible-server create \
        --yes \
        --resource-group "$RESOURCE_GROUP" \
        --name "$pg_name" \
        --vnet "$vnet_name" \
        --version "$PG_VERSION" \
        --tier "$PG_TIER" \
        --sku-name "$PG_SKU" \
        --storage-size "$PG_STORAGE_SIZE" \
        --active-directory-auth Enabled \
        --password-auth Disabled

# Add the managed identity as PostgreSQL server administrator.
pg-admin:
    #!/usr/bin/env bash
    set -euo pipefail

    pg_name="$PG_NAME"
    if [[ -z "$pg_name" ]]; then
        group_id="$(az group show --resource-group "$RESOURCE_GROUP" --query id --output tsv)"
        suffix="$(printf '%s' "$group_id" | sha256sum | cut -c1-6)"
        pg_name="postgres-$suffix"
    fi

    principal_id="$(az identity list \
        --resource-group "$RESOURCE_GROUP" \
        --query '[0].principalId' \
        --output tsv)"
    if [[ -z "$principal_id" ]]; then
        printf 'No managed identity found in RESOURCE_GROUP %s.\n' "$RESOURCE_GROUP" >&2
        exit 1
    fi

    az postgres flexible-server ad-admin create \
        --resource-group "$RESOURCE_GROUP" \
        --server-name "$pg_name" \
        --display-name "$RESOURCE_GROUP-identity" \
        --object-id "$principal_id" \
        --type ServicePrincipal

# Create and assign a managed identity to the VM.
managed-identity:
    az identity create --resource-group "$RESOURCE_GROUP" --name "$RESOURCE_GROUP-identity"
    az vm identity assign --resource-group "$RESOURCE_GROUP" --name "$VM_NAME" --identities "$RESOURCE_GROUP-identity"

# Create an SSH key resource for Azure VMs.
ssh-key:
    az sshkey create --name "$SSH_KEY_NAME" --resource-group "$RESOURCE_GROUP"

# Install Docker and optionally run Tailscale on the VM.
docker-tailscale:
    #!/usr/bin/env bash
    set -euo pipefail

    scripts=()
    if [[ -n "$VM_COMMAND" ]]; then
        scripts+=("$VM_COMMAND")
    fi
    scripts+=(
        "sudo tdnf install moby-engine moby-cli ca-certificates -y"
        "sudo systemctl enable docker.service"
        "sudo systemctl daemon-reload"
        "sudo systemctl start docker.service"
    )

    if [[ -n "$TS_AUTHKEY" ]]; then
        printf -v quoted_authkey '%q' "$TS_AUTHKEY"
        scripts+=(
            "docker rm -f tailscaled"
            "sudo rm -rf /var/lib/tailscale/"
            "export TS_AUTHKEY=$quoted_authkey"
            "docker run -d --name=tailscaled -v /var/lib:/var/lib -v /dev/net/tun:/dev/net/tun --network=host --cap-add=NET_ADMIN --cap-add=NET_RAW --env TS_STATE_DIR=/var/lib/tailscale/state --env TS_AUTHKEY --env TS_EXTRA_ARGS='--hostname=$RESOURCE_GROUP-$VM_NAME' tailscale/tailscale"
        )
    else
        printf 'TS_AUTHKEY not set. Installing Docker without starting Tailscale.\n'
    fi

    az vm run-command invoke \
        --resource-group "$RESOURCE_GROUP" \
        --name "$VM_NAME" \
        --command-id RunShellScript \
        --scripts "${scripts[@]}"

# Run VM_COMMAND, if set, followed by VM_SCRIPT on the VM.
run-script:
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ -z "$VM_SCRIPT" ]]; then
        printf 'VM_SCRIPT not set.\n' >&2
        exit 1
    fi
    if [[ ! -f "$VM_SCRIPT" ]]; then
        printf 'VM_SCRIPT does not exist: %s\n' "$VM_SCRIPT" >&2
        exit 1
    fi

    scripts=()
    if [[ -n "$VM_COMMAND" ]]; then
        scripts+=("$VM_COMMAND")
    fi
    scripts+=("@$VM_SCRIPT")

    az vm run-command invoke \
        --resource-group "$RESOURCE_GROUP" \
        --name "$VM_NAME" \
        --command-id RunShellScript \
        --scripts "${scripts[@]}"

# Print the SSH command for the VM.
ssh:
    #!/usr/bin/env bash
    set -euo pipefail
    fqdn="$(az vm show \
        --resource-group "$RESOURCE_GROUP" \
        --name "$VM_NAME" \
        --show-details \
        --query fqdns \
        --output tsv)"
    if [[ -z "$fqdn" ]]; then
        printf 'VM FQDN is empty.\n' >&2
        exit 1
    fi
    printf 'ssh azureuser@%s\n' "$fqdn"

# Switch between the SUB1 and SUB2 Azure subscriptions.
subscription:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -z "$SUB1" || -z "$SUB2" ]]; then
        printf 'SUB1 and SUB2 must be set.\n' >&2
        exit 1
    fi

    current="$(az account show --query name --output tsv)"
    case "$current" in
        "$SUB1") target="$SUB2" ;;
        "$SUB2") target="$SUB1" ;;
        *) target="$SUB1" ;;
    esac

    printf 'Switching to subscription %s\n' "$target"
    az account set --subscription "$target"
